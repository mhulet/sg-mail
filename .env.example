# Copier en .env (jamais commité) et remplir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facultatif : limiter l'import initial pendant les essais (vide = tout importer).
GMAIL_IMPORT_LIMIT=
IMAP_IMPORT_LIMIT=

# Expéditeur des emails de l'app (invitations, mot de passe oublié).
MAILER_FROM=

# Notifications temps réel Gmail (production, voir README) : sujet Pub/Sub et secret de l'URL de push.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_TOKEN=
