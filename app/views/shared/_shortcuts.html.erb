<dialog class="shortcuts" data-shortcuts-target="help">
  <h2>Raccourcis clavier</h2>
  <div class="columns">
    <dl>
      <dt>j / k</dt><dd>Fil suivant / précédent</dd>
      <dt>o ou Entrée</dt><dd>Ouvrir le fil</dd>
      <dt>x</dt><dd>Cocher le fil</dd>
      <dt>e</dt><dd>Archiver</dd>
      <dt>z</dt><dd>Annuler l'archivage (juste après)</dd>
      <dt>l</dt><dd>Répondre plus tard</dd>
      <dt>s</dt><dd>Mettre de côté</dd>
      <dt>Maj + i / Maj + u</dt><dd>Marquer comme lu / non lu</dd>
    </dl>
    <dl>
      <dt>r / a / f</dt><dd>Répondre / à tous / transférer (dernier message)</dd>
      <dt>u</dt><dd>Revenir à la liste</dd>
      <dt>c</dt><dd>Écrire un message</dd>
      <dt>/</dt><dd>Rechercher</dd>
      <dt>g puis i, f, p, s, t, d</dt><dd>Réception, Feed, Paper Trail, À trier, Mes tâches, Brouillons</dd>
      <dt>?</dt><dd>Cette aide</dd>
    </dl>
  </div>
  <form method="dialog"><button class="primary">Fermer</button></form>
</dialog>
