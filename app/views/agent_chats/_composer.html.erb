<%# Écrire à l'agent : dans une discussion existante (chat), ou en commencer une (depuis un fil : conversation). %>
<% url = chat ? agent_chat_agent_messages_path(chat) : agent_chats_path %>
<% busy = chat && (chat.running? || chat.waiting?) %>
<%= form_with url: url, class: "agent-composer", data: { controller: "agent-composer" } do |f| %>
  <%= hidden_field_tag :conversation_id, conversation.id if conversation && !chat %>
  <%= hidden_field_tag :from_conversation, "1" if conversation %>
  <% if conversation && !busy %>
    <div class="agent-prompts">
      <% [ "Résume ce fil.", "Que suggères-tu ?", "Prépare une réponse." ].each do |prompt| %>
        <button type="submit" name="prompt" value="<%= prompt %>" class="chip" formnovalidate><%= prompt.delete_suffix(".").delete_suffix(" ?") %></button>
      <% end %>
    </div>
  <% end %>
  <%= f.text_area :text, rows: 2, required: true, disabled: busy, aria: { label: "Message à #{agent.name}" },
        placeholder: busy ? (chat.waiting? ? "Confirme ou refuse d'abord l'action ci-dessus." : "#{agent.name} réfléchit…") : "Demande à #{agent.name}…",
        data: { action: "keydown->agent-composer#keydown", shortcut: ("." if conversation) } %>
  <%= f.submit "Envoyer", disabled: busy %>
<% end %>
