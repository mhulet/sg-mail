<% content_for :title, "Mot de passe oublié · SG Mail" %>
<h1>Mot de passe oublié</h1>

<%= form_with url: passwords_path, class: "stacked" do |form| %>
  <%= form.label :email_address, "Adresse email" %>
  <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  <p><%= form.submit "Recevoir un lien" %></p>
<% end %>
