<% content_for :title, "Nouveau mot de passe · SG Mail" %>
<h1>Nouveau mot de passe</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "stacked" do |form| %>
  <%= form.label :password, "Nouveau mot de passe" %>
  <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
  <%= form.label :password_confirmation, "Encore une fois" %>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  <p><%= form.submit "Enregistrer" %></p>
<% end %>
