<% content_for :title, "#{@conversation.title} · SG Mail" %>
<% content_for :head do %><%= turbo_refreshes_with method: :morph, scroll: :preserve if @agent %><% end %>
<p class="thread-top">
  <%= link_to "← #{Screening::BUCKET_LABELS.fetch(@bucket || "imbox")}", conversations_path(box: (@bucket unless @bucket.in?([ nil, "imbox" ]))), data: { shortcut: "u" } %>
  <%= link_to mailbox_chip(@conversation.mailbox), conversations_path(mailbox_id: @conversation.mailbox_id) %>
  <% if @twins.any? %>
    <span class="twins muted">aussi reçu dans
      <% @twins.each do |twin| %><%= link_to mailbox_chip(twin.mailbox), conversation_path(twin), title: "Ouvrir la copie de #{twin.mailbox.address}" %><% end %>
    </span>
  <% end %>
</p>
<h1 class="thread-title"><%= @conversation.title %></h1>
<% if @screening.in?(%w[pending blocked]) %>
  <p class="card screening" data-controller="stamp">
    <% if @screening == "pending" %>
      <strong><%= @conversation.sender_display %></strong> &lt;<%= @conversation.sender_address %>&gt; t'écrit pour la première fois. Accepter dans :
    <% else %>
      Tu as bloqué <strong><%= @conversation.sender_address %></strong> : ses emails restent hors de ta réception.
    <% end %>
    <%= render "screenings/buttons", address: @conversation.sender_address, current: @screening %>
    <span class="stamp" data-stamp-target="stamp" aria-hidden="true"></span>
  </p>
<% end %>
<div class="actions thread-actions">
  <% if @archived %>
    <span class="muted">Archivé.</span>
    <%= button_to "Remettre dans la réception", archive_conversation_path(@conversation), method: :patch, params: { on: "0" }, class: "link" %>
  <% else %>
    <%= button_to "Archiver", archive_conversation_path(@conversation), method: :patch, params: { on: "1" }, class: "primary hint", data: { shortcut: "e" } %>
  <% end %>
  <%= button_to "Marquer comme non lu", unread_conversation_path(@conversation), class: "link", data: { shortcut: "U" } %>
  <% ConversationState::STACKS.each do |stack| %>
    <% on = @stacks.include?(stack) %>
    <%= button_to on ? "Retirer de « #{ConversationState::STACK_LABELS.fetch(stack)} »" : ConversationState::ACTION_LABELS.fetch(stack),
          stack_conversation_path(@conversation), method: :patch, params: { stack: stack, on: on ? "0" : "1" }, class: "link",
          data: { shortcut: { "reply_later" => "l", "set_aside" => "s" }.fetch(stack) } %>
  <% end %>
  <% if @screening == "accepted" %>
    <span class="muted">Emails de <%= @conversation.sender_address %> rangés dans « <%= Screening::BUCKET_LABELS.fetch(@bucket) %> ». Déplacer vers :</span>
    <%= render "screenings/buttons", address: @conversation.sender_address, current: @screening, bucket: @bucket %>
  <% end %>
  <%= form_with url: assign_conversation_path(@conversation), method: :patch, class: "inline" do |f| %>
    <%= f.label :assignee_id, "Qui s'en occupe ?" %>
    <%= f.select :assignee_id, [ [ "Personne", "" ] ] + @people.map { |p| [ p.display_name, p.id ] },
          { selected: @conversation.assignee_id }, onchange: "this.form.requestSubmit()" %>
  <% end %>
</div>

<%= render "agent_chats/panel", chat: @agent_chat, agent: @agent, conversation: @conversation if @agent %>

<div data-controller="viewer" class="viewer-scope">
<% @messages.each do |message| %>
  <article id="<%= dom_id(message) %>" class="card">
    <header class="message-head">
      <%= avatar(message.from_display) %>
      <p>
        <strong><%= message.from_display %></strong> <span class="muted">&lt;<%= message.from_address %>&gt;</span><br>
        <span class="muted">À : <%= message.to_addresses.join(", ") %><%= " · Cc : #{message.cc_addresses.join(", ")}" if message.cc_addresses.any? %></span>
      </p>
      <time class="muted"><%= message.sent_at && l(message.sent_at, format: :long) %></time>
    </header>

    <% if message.body_html.present? %>
      <% email = email_document(message) %>
      <div class="email" data-controller="email-frame">
        <%# Bac à sable : aucun script ne s'y exécute ; la même origine sert seulement à ajuster la hauteur et à charger la police. %>
        <iframe class="body<%= " designed" if email.designed? %>" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
          srcdoc="<%= email.to_html %>" title="Contenu du message"
          data-email-frame-target="frame" data-action="load->email-frame#fit"></iframe>
        <% if email.quoted? %>
          <button type="button" class="quote-toggle" data-action="email-frame#toggleQuote" aria-expanded="false" title="Afficher le texte cité">•••</button>
        <% end %>
      </div>
    <% else %>
      <pre class="body"><%= message.body_text %></pre>
    <% end %>

    <%= render "attachments/list", message: message %>

    <p class="actions message-actions">
      <% last = message == @messages.last %>
      <%= link_to "Répondre", new_draft_path(message_id: message.id, kind: "reply"), data: { shortcut: ("r" if last) } %>
      <%= link_to "Répondre à tous", new_draft_path(message_id: message.id, kind: "reply_all"), data: { shortcut: ("a" if last) } %>
      <%= link_to "Transférer", new_draft_path(message_id: message.id, kind: "forward"), data: { shortcut: ("f" if last) } %>
    </p>

    <% readers, others = @people.partition { |person| message.read_by?(person) } %>
    <p class="muted read-by">
      <span class="avatars"><% readers.each do |reader| %><%= avatar(reader.display_name, size: "small") %><% end %></span>
      <%= readers.any? ? "Lu par #{readers.map(&:display_name).to_sentence}" : "Lu par personne" %>
      <%= "· pas encore par #{others.map(&:display_name).to_sentence}" if others.any? %>
    </p>
  </article>
<% end %>
<%= render "attachments/viewer" %>
</div>

<section class="card internal">
  <h2>Notes internes</h2>
  <p class="muted">Visibles de l'équipe seulement, jamais envoyées.</p>
  <% @notes.each do |note| %>
    <div id="<%= dom_id(note) %>" class="note">
      <p><strong><%= note.user.display_name %></strong> <span class="muted"><%= l(note.created_at, format: :short) %></span>
        <% if note.user == Current.user %>
          <%= button_to "Supprimer", conversation_note_path(@conversation, note), method: :delete, class: "link muted", form: { class: "inline" } %>
        <% end %>
      </p>
      <%= simple_format(note.body) %>
    </div>
  <% end %>
  <%= form_with model: Note.new, url: conversation_notes_path(@conversation) do |f| %>
    <%= f.text_area :body, rows: 3, placeholder: "Une note pour l'équipe…", required: true, aria: { label: "Note" } %>
    <%= f.submit "Ajouter la note" %>
  <% end %>
</section>
