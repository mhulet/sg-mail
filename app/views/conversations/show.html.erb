<% content_for :title, "#{@conversation.title} · SG Mail" %>
<p>
  <%= link_to "← #{Screening::BUCKET_LABELS.fetch(@bucket || "imbox")}", conversations_path(box: (@bucket unless @bucket.in?([ nil, "imbox" ]))) %> ·
  <%= link_to @conversation.mailbox.address, conversations_path(mailbox_id: @conversation.mailbox_id) %>
</p>
<h1><%= @conversation.title %></h1>
<% if @screening.in?(%w[pending blocked]) %>
  <p class="card screening">
    <% if @screening == "pending" %>
      <strong><%= @conversation.sender_display %></strong> &lt;<%= @conversation.sender_address %>&gt; t'écrit pour la première fois. Accepter dans :
    <% else %>
      Tu as bloqué <strong><%= @conversation.sender_address %></strong> : ses emails restent hors de ta réception.
    <% end %>
    <%= render "screenings/buttons", address: @conversation.sender_address, current: @screening %>
  </p>
<% end %>
<div class="actions">
  <%= button_to "Marquer comme non lu", unread_conversation_path(@conversation), class: "link" %>
  <% ConversationState::STACKS.each do |stack| %>
    <% on = @stacks.include?(stack) %>
    <%= button_to on ? "Retirer de « #{ConversationState::STACK_LABELS.fetch(stack)} »" : ConversationState::ACTION_LABELS.fetch(stack),
          stack_conversation_path(@conversation), method: :patch, params: { stack: stack, on: on ? "0" : "1" }, class: "link" %>
  <% end %>
  <% if @screening == "accepted" %>
    <span class="muted">Emails de <%= @conversation.sender_address %> rangés dans « <%= Screening::BUCKET_LABELS.fetch(@bucket) %> ». Déplacer vers :</span>
    <%= render "screenings/buttons", address: @conversation.sender_address, current: @screening, bucket: @bucket %>
  <% end %>
  <%= form_with url: assign_conversation_path(@conversation), method: :patch, class: "inline" do |f| %>
    <%= f.label :assignee_id, "Qui s'en occupe ?" %>
    <%= f.select :assignee_id, [ [ "Personne", "" ] ] + @people.map { |p| [ p.display_name, p.id ] },
          { selected: @conversation.assignee_id }, onchange: "this.form.requestSubmit()" %>
  <% end %>
</div>

<section class="card internal">
  <h2>Tâches</h2>
  <ul class="tasks">
    <%= render partial: "tasks/task", collection: @tasks %>
  </ul>
  <%= render "tasks/form", people: @people, conversation: @conversation %>
</section>

<% @messages.each do |message| %>
  <article id="<%= dom_id(message) %>" class="card">
    <p>
      <strong><%= message.from_display %></strong>
      <span class="muted">&lt;<%= message.from_address %>&gt; · <%= message.sent_at && l(message.sent_at, format: :long) %></span><br>
      <span class="muted">À : <%= message.to_addresses.join(", ") %><%= " · Cc : #{message.cc_addresses.join(", ")}" if message.cc_addresses.any? %></span>
    </p>

    <% if message.body_html.present? %>
      <%# Bac à sable : pas de scripts, pas d'accès à la page SG Mail. %>
      <iframe class="body" sandbox srcdoc="<%= message.body_html %>" title="Contenu du message"></iframe>
    <% else %>
      <pre class="body"><%= message.body_text %></pre>
    <% end %>

    <% if message.attachments.any? %>
      <ul class="attachments">
        <% message.attachments.each do |attachment| %>
          <li>📎 <%= link_to attachment["filename"], message_attachment_path(message, attachment["index"]), data: { turbo: false } %>
            <span class="muted"><%= number_to_human_size(attachment["size"]) %></span></li>
        <% end %>
      </ul>
    <% elsif message.has_attachments %>
      <%= button_to "Afficher les pièces jointes", message_attachments_path(message), class: "link" %>
    <% end %>

    <p class="actions">
      <%= link_to "Répondre", new_draft_path(message_id: message.id, kind: "reply") %>
      <%= link_to "Répondre à tous", new_draft_path(message_id: message.id, kind: "reply_all") %>
      <%= link_to "Transférer", new_draft_path(message_id: message.id, kind: "forward") %>
      <%= button_to "Créer une tâche", tasks_path(task: { message_id: message.id, title: "Traiter : #{@conversation.title}", assignee_id: Current.user.id }), class: "link" %>
    </p>

    <% readers, others = @people.partition { |person| message.read_by?(person) } %>
    <p class="muted read-by">
      <%= readers.any? ? "Lu par #{readers.map(&:display_name).to_sentence}" : "Lu par personne" %>
      <%= "· pas encore par #{others.map(&:display_name).to_sentence}" if others.any? %>
    </p>
  </article>
<% end %>

<section class="card internal">
  <h2>Notes internes</h2>
  <p class="muted">Visibles de l'équipe seulement, jamais envoyées.</p>
  <% @notes.each do |note| %>
    <div id="<%= dom_id(note) %>" class="note">
      <p><strong><%= note.user.display_name %></strong> <span class="muted"><%= l(note.created_at, format: :short) %></span>
        <% if note.user == Current.user %>
          <%= button_to "Supprimer", conversation_note_path(@conversation, note), method: :delete, class: "link muted", form: { class: "inline" } %>
        <% end %>
      </p>
      <%= simple_format(note.body) %>
    </div>
  <% end %>
  <%= form_with model: Note.new, url: conversation_notes_path(@conversation) do |f| %>
    <%= f.text_area :body, rows: 3, placeholder: "Une note pour l'équipe…", required: true, aria: { label: "Note" } %>
    <%= f.submit "Ajouter la note" %>
  <% end %>
</section>
