<% selectable = local_assigns.fetch(:selectable, false) %>
<tr class="<%= "unread" if conversation.unread %>" data-shortcuts-target="row">
  <% if selectable %>
    <td class="select"><%= check_box_tag "ids[]", conversation.id, false, form: "bulk", id: nil, aria: { label: "Choisir « #{conversation.title} »" } %></td>
  <% end %>
  <td class="sender"><%= conversation.last_sender %><%= tag.span(" (#{conversation.messages_count})", class: "muted") if conversation.messages_count > 1 %></td>
  <td class="subject">
    <%= link_to conversation.title, conversation_path(conversation), data: { shortcuts_target: "link" } %>
    <%= tag.span("→ #{conversation.assignee.display_name}", class: "assignee") if conversation.assignee %>
    <span class="muted snippet"><%= conversation.snippet&.truncate(90) %></span>
  </td>
  <% if show_mailbox %><td class="muted mailbox"><%= conversation.mailbox.address %></td><% end %>
  <td class="muted nowrap date"><%= conversation.last_message_at && l(conversation.last_message_at, format: :short) %></td>
</tr>
