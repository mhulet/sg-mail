<% selectable = local_assigns.fetch(:selectable, false) %>
<tr class="<%= "unread" if conversation.unread %>" data-shortcuts-target="row">
  <% if selectable %>
    <td class="select"><%= check_box_tag "ids[]", conversation.id, false, form: "bulk", id: nil, aria: { label: "Choisir « #{conversation.title} »" } %></td>
  <% end %>
  <td class="who"><%= avatar(conversation.last_sender) %></td>
  <td class="sender"><%= conversation.last_sender %><%= tag.span(conversation.messages_count, class: "count", title: "#{conversation.messages_count} messages") if conversation.messages_count > 1 %>
    <%= tag.span("→ #{conversation.assignee.display_name}", class: "assignee") if conversation.assignee %></td>
  <td class="subject">
    <% if local_assigns[:highlights] %>
      <%= link_to highlight_words(conversation.title, highlights), conversation_path(conversation), data: { shortcuts_target: "link" } %>
      <span class="snippet excerpt"><%= search_excerpt(local_assigns[:match], highlights, fallback: conversation.snippet) %></span>
    <% else %>
      <%= link_to conversation.title, conversation_path(conversation), data: { shortcuts_target: "link" } %>
      <span class="snippet"><%= conversation.snippet&.truncate(140) %></span>
    <% end %>
  </td>
  <% if show_mailbox %><td class="mailbox"><%= mailbox_chip(conversation.mailbox.address) %></td><% end %>
  <td class="date"><%= conversation.last_message_at && l(conversation.last_message_at, format: :short) %></td>
</tr>
