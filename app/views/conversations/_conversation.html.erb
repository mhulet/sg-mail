<% selectable = local_assigns.fetch(:selectable, false) %>
<% attachments = conversation.listed_attachments %>
<% swipe = local_assigns.fetch(:swipe, false) %>
<%= tag.tr class: ("unread" if conversation.unread_anywhere?), data: { shortcuts_target: "row" }.merge(swipe ? {
      controller: "swipe", swipe_archive_url_value: archive_conversation_path(conversation),
      swipe_later_url_value: (stack_conversation_path(conversation) if swipe == :both) } : {}) do %>
  <% if selectable %>
    <td class="select"><%= check_box_tag "ids[]", conversation.id, false, form: "bulk", id: nil, aria: { label: "Choisir « #{conversation.title} »" } %></td>
  <% end %>
  <td class="sender"><%= conversation.last_sender %><%= tag.span(conversation.messages_count, class: "count", title: "#{conversation.messages_count} messages") if conversation.messages_count > 1 %>
    <%= tag.span("→ #{conversation.assignee.display_name}", class: "assignee") if conversation.assignee %></td>
  <td class="subject">
    <% if local_assigns[:highlights] %>
      <%= link_to highlight_words(conversation.title, highlights), conversation_path(conversation), data: { shortcuts_target: "link" } %>
      <span class="snippet excerpt"><%= search_excerpt(local_assigns[:match], highlights, fallback: conversation.snippet) %></span>
    <% else %>
      <%= link_to conversation.title, conversation_path(conversation), data: { shortcuts_target: "link" } %>
      <span class="snippet"><%= conversation.snippet&.truncate(140) %></span>
    <% end %>
  </td>
  <% if attachments.any? %>
    <td class="files">
      <% attachments.first(2).each do |message_id, attachment| %>
        <% download = message_attachment_path(message_id, attachment["index"]) %>
        <% kind = attachment_viewer_kind(attachment) %>
        <%= link_to (kind ? message_attachment_path(message_id, attachment["index"], view: 1) : download),
              class: "file-chip", data: { family: attachment_family(attachment), turbo: false, action: ("viewer#open" if kind), viewer_target: "item",
                viewer_kind: kind, viewer_group: conversation.id, viewer_name: attachment["filename"], viewer_download: download } do %>
          <span class="file-chip-type" aria-hidden="true"><%= attachment_extension(attachment).presence || "?" %></span><span class="file-chip-name"><%= attachment["filename"] %></span>
        <% end %>
      <% end %>
      <%= tag.span("+#{attachments.size - 2}", class: "file-more", title: pluralize(attachments.size, "pièce jointe", plural: "pièces jointes")) if attachments.size > 2 %>
    </td>
  <% end %>
  <% if show_mailbox %><td class="mailbox"><% conversation.mailboxes_with_twins.each do |mailbox| %><%= mailbox_chip(mailbox) %><% end %></td><% end %>
  <td class="date"><%= list_time(conversation.last_message_at) %></td>
<% end %>
