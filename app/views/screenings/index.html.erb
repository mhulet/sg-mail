<% content_for :title, "À trier · #{current_account.name} · SG Mail" %>
<header class="space-head">
  <h1>À trier</h1>
  <p class="tagline">Ils t'écrivent pour la première fois. Oui ou non ?</p>
</header>
<p class="muted">Ces expéditeurs t'écrivent pour la première fois. Accepte-les dans ta réception, dans le Feed
  (lettres d'info, lectures) ou dans le Paper Trail (reçus, notifications) ; bloque-les et ils restent dehors.
  Ta décision ne vaut que pour toi, rien n'est supprimé.</p>

<% if @pending.none? %>
  <%= render "shared/empty", line: "Personne n'attend à la porte." %>
<% end %>

<table class="screener">
  <% @pending.each do |conversation| %>
    <tr id="<%= dom_id(conversation) %>" data-controller="stamp">
      <td class="who"><%= avatar(conversation.sender_display) %></td>
      <td class="sender">
        <strong><%= conversation.sender_display %></strong>
        <span class="muted address"><%= conversation.sender_address %></span>
        <% if conversation.sender_conversations_count > 1 %>
          <span class="muted">· <%= conversation.sender_conversations_count %> fils</span>
        <% end %>
      </td>
      <td class="subject">
        <%= link_to conversation.title, conversation_path(conversation) %>
        <span class="muted"><%= conversation.snippet %></span>
      </td>
      <td class="decide"><%= render "screenings/buttons", address: conversation.sender_address %><span class="stamp" data-stamp-target="stamp" aria-hidden="true"></span></td>
    </tr>
  <% end %>
</table>

<% if @blocked.any? %>
  <h2>Bloqués</h2>
  <table class="blocked-senders">
    <% @blocked.each do |screening| %>
      <tr>
        <td class="address"><%= screening.address %></td>
        <td class="muted">depuis le <%= l(screening.updated_at.to_date, format: :long) %></td>
        <td class="nowrap"><%= button_to "Débloquer", screenings_path, params: { address: screening.address, decision: "accepted" }, class: "link" %></td>
      </tr>
    <% end %>
  </table>
<% end %>
