<% content_for :title, "Connexion · SG Mail" %>
<h1>Connexion</h1>

<%= form_with url: session_path, class: "stacked" do |form| %>
  <%= form.label :email_address, "Adresse email" %>
  <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  <%= form.label :password, "Mot de passe" %>
  <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  <p><%= form.submit "Se connecter" %></p>
<% end %>

<p><%= link_to "Mot de passe oublié ?", new_password_path %></p>
