<li id="<%= dom_id(task) %>" class="<%= "done" if task.done? %>">
  <%= button_to task.done? ? "↺" : "✓", task_path(task, status: task.done? ? "open" : "done"), method: :patch, class: "link",
        title: task.done? ? "Rouvrir" : "Terminer" %>
  <span><%= task.title %></span>
  <span class="muted">
    <%= "· #{task.assignee.display_name}" if task.assignee %>
    <% if task.due_on %>· <span class="<%= "overdue" if task.overdue? %>">pour le <%= l(task.due_on, format: :short) %></span><% end %>
    <% if local_assigns[:with_conversation] && task.conversation %>· <%= link_to task.conversation.title, conversation_path(task.conversation, anchor: task.message_id && "message_#{task.message_id}") %><% end %>
  </span>
  <%= button_to "Supprimer", task_path(task), method: :delete, class: "link muted", form: { data: { turbo_confirm: "Supprimer cette tâche ?" } } %>
</li>
