<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "SG Mail" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="SG Mail">
    <meta name="theme-color" content="#f7f3ea" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#17111f" media="(prefers-color-scheme: dark)">
    <meta name="application-name" content="SG Mail">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= preload_link_tag "inter.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag "eb-garamond.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="shortcuts" data-space="<%= current_space %>" class="<%= authenticated? ? "with-sidebar" : "bare" %>"
    <%= tag.attributes(data: { badge: imbox_unread_count }) if Current.account %>>
    <% if authenticated? %>
      <aside class="sidebar">
        <div class="brand">
          <%= link_to Current.account ? account_root_path : root_path, class: "brand-name" do %><span class="mark" aria-hidden="true"></span>SG Mail<% end %>
          <% if Current.account && (Current.user.accounts.many? || Current.user.staff?) %>
            <details class="account-switcher">
              <summary data-shortcut="g c" title="Changer de client (g puis c)"><span class="account"><%= Current.account.name %></span></summary>
              <nav aria-label="Clients">
                <% Current.user.accounts.order(:name).each do |account| %>
                  <%= link_to account.name, account_root_path(account_id: account.id), aria: { current: (account == Current.account) || nil } %>
                <% end %>
                <%= link_to "Tous les clients", accounts_path(account_id: nil), class: "all" %>
              </nav>
            </details>
          <% elsif Current.account %>
            <span class="account"><%= Current.account.name %></span>
          <% end %>
        </div>
        <% if Current.account %>
          <%= link_to new_draft_path, class: [ "compose-button", "hint", ("floating" if list_page?) ], data: { shortcut: "c" } do %>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M13.5 3.5l3 3L7 16l-4 1 1-4 9.5-9.5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>Écrire
          <% end %>
          <nav class="spaces" aria-label="Espaces">
            <%= nav_link "Réception", account_root_path, shortcut: "g i", space: "imbox", current: imbox_mailbox_page? %>
            <% if sidebar_mailboxes.many? %>
              <div class="sub-spaces" role="group" aria-label="Réception par boîte">
                <% sidebar_mailboxes.each do |mailbox| %><%= mailbox_nav_link(mailbox) %><% end %>
              </div>
            <% end %>
            <%= nav_link "Feed", conversations_path(box: "feed"), shortcut: "g f", space: "feed" %>
            <%= nav_link "Paper Trail", conversations_path(box: "paper_trail"), shortcut: "g p", space: "trail" %>
            <%= nav_link screener_label, screenings_path, shortcut: "g s", space: "screener" %>
            <span class="nav-label">Mes piles</span>
            <%= nav_link "Plus tard", conversations_path(stack: "reply_later"), space: "later" %>
            <%= nav_link "De côté", conversations_path(stack: "set_aside"), space: "aside" %>
            <span class="nav-label">À faire</span>
            <%= nav_link "Mes tâches", tasks_path, shortcut: "g t", space: "note-ink" %>
            <%= nav_link "Brouillons", drafts_path, shortcut: "g d", space: "muted" %>
            <% if Current.account.agent_enabled? %>
              <% sidebar_agent = Agent.for(Current.user) %><%= nav_link sidebar_agent.name, agent_chats_path, shortcut: "g a", space: sidebar_agent.color %>
            <% end %>
          </nav>
          <% unless controller_name == "searches" %>
            <%= form_with url: search_path, method: :get, class: "search",
                  data: { controller: "search", action: "keydown->search#keydown focusout->search#leave" } do |f| %>
              <%= f.search_field :q, value: params[:q], placeholder: "Rechercher", autocomplete: "off", aria: { label: "Rechercher" },
                    data: { shortcut: "/", search_target: "input", action: "input->search#type" } %>
              <kbd>/</kbd>
              <%= turbo_frame_tag "search_preview", target: "_top", data: { search_target: "preview" } %>
            <% end %>
          <% end %>
        <% end %>
        <details class="settings">
          <summary><%= avatar(Current.user.display_name, size: "small") %><span class="name"><%= Current.user.display_name %></span></summary>
          <nav aria-label="Réglages">
            <% if Current.account %>
              <%= nav_link "Boîtes", mailboxes_path %>
              <%= nav_link "Partage", sharing_path %>
              <%= nav_link "Membres", memberships_path %>
              <%= nav_link "Agent", agent_settings_path %>
              <%= nav_link "Jetons d'API", api_tokens_path %>
            <% end %>
            <% if !Current.account && (Current.user.accounts.many? || Current.user.staff?) %><%= link_to "Clients", accounts_path(account_id: nil) %><% end %>
            <%= link_to "Installer l'app", install_path(account_id: nil), class: "install-link" %>
            <%= link_to "Notifications", push_subscriptions_path(account_id: nil) %>
            <%= link_to "Passkeys", passkeys_path(account_id: nil) %>
            <%= button_to "Déconnexion", session_path(account_id: nil), method: :delete, class: "link" %>
          </nav>
        </details>
      </aside>
    <% end %>
    <div class="page">
      <% if alert %><p class="flash alert" role="alert"><%= alert %></p><% end %>
      <main>
        <% unless authenticated? %><p class="bare-brand"><span class="mark" aria-hidden="true"></span>SG Mail</p><% end %>
        <%= yield %>
      </main>
    </div>
    <% if (kind = flash[:flourish].presence_in(%w[archive unarchive reply_later set_aside sent])) %>
      <%= render "shared/flourish", kind: kind, count: flash[:flourish_count] %>
    <% end %>
    <% if notice %>
      <div class="toast" role="status" data-controller="toast">
        <p class="flash notice"><%= notice %></p>
        <% if flash[:undo].present? %>
          <%= button_to "Annuler", bulk_conversations_path, params: { operation: "unarchive", ids: flash[:undo] }, class: "undo hint", data: { shortcut: "z" } %>
        <% end %>
      </div>
    <% end %>
    <%= render "shared/shortcuts" if authenticated? %>
  </body>
</html>
